{
  "name": "gomile",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "mobile:start": "corepack pnpm --filter gomileapp start",
    "mobile:lan": "corepack pnpm --filter gomileapp start -- --lan",
    "mobile:tunnel": "corepack pnpm --filter gomileapp start --tunnel"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
