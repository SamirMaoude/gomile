{
  "name": "gomile",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:lan": "pnpm --dir apps/mobile start --lan",
    "mobile:tunnel": "pnpm --dir apps/mobile start --tunnel"
  }
}
