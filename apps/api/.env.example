# Base de données PostgreSQL (Docker local)
DATABASE_URL="postgresql://gomile:gomile@localhost:5432/gomile?schema=public"

# Cache / file de messages (Redis local)
REDIS_URL="redis://localhost:6379"

# API
PORT=3000
APP_URL="http://localhost:3001"

# Auth JWT (dev only: remplacer en environnements partagés)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# OpenRouteService (geocoding + routing)
ORS_API_KEY="your-openrouteservice-key"
ORS_BASE_URL="https://api.openrouteservice.org"

# AWS S3 for file uploads
# Create an IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject on your bucket
AWS_REGION="your-chosen-region"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="your-bucket-name"

# Create a Resend account and create an API key to use its services
RESEND_API_KEY="your-resend-api-key"

