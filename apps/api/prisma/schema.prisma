// modifier ici pour créer le schéma relationnel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MERCHANT
  DRIVER
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         Role
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant?
  driver   Driver?
}

model Merchant {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  phone       String?

  locals Local[]
}

model Driver {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String

  kycStatus  KycStatus @default(PENDING)
  kycDocUrl  String?
  isOnline   Boolean   @default(false)

  walletBalance Float @default(0)
}

model Local {
  id         String  @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name      String
  address   String
  latitude  Float
  longitude Float

  apiKeys ApiKey[]
}

model ApiKey {
  id        String   @id @default(uuid())
  localId   String
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)

  key       String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
