// modifier ici pour créer le schéma relationnel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 4 role, admin, driver, customer and merchant
enum Role {
  ADMIN
  DRIVER
  CUSTOMER
  MERCHANT
}

enum KycStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum WalletEntryType {
  CREDIT
  DEBIT
}

enum OrderStatus {
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum HandshakeType {
  A
  B
}

model Merchant {
  id        String   @id @default(uuid()) @db.Uuid // id is unique, calling uuid() will generate a unique id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store[]
  orders    Order[]
}

model Store {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  name       String
  address    String
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  orders   Order[]

  @@index([merchantId])
}

// An order is created by a merchant, assigned to a store, and can be accepted by a driver
model Order {
  id         String      @id @default(uuid()) @db.Uuid
  merchantId String      @db.Uuid
  storeId    String      @db.Uuid
  driverId   String?     @db.Uuid
  status     OrderStatus @default(SEARCHING_DRIVER)

  customerName   String
  customerPhone  String
  dropOffAddress String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acceptedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  driver     Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  handshakes Handshake[]

  @@index([merchantId])
  @@index([storeId])
  @@index([driverId])
  @@index([status])
}

// A driver can have many orders, KYC submissions and a wallet
model Driver {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  kycStatus KycStatus @default(PENDING)

  orders         Order[]
  kycSubmissions KycSubmission[]
  wallet         Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Handshake {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  type     HandshakeType
  codeHash String

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  expiresAt  DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([orderId])
}

model KycSubmission {
  id       String    @id @default(uuid()) @db.Uuid
  driverId String    @db.Uuid
  status   KycStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @unique @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver  Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@index([driverId])
}

model WalletEntry {
  id        String          @id @default(uuid()) @db.Uuid
  walletId  String          @db.Uuid
  amount    Int
  type      WalletEntryType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}
