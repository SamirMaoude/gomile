{
  "name": "gomile/woocommerce-shipment",
  "description": "Unit tests and development tooling for the Gomile Shipment WooCommerce plugin.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "GomileShipment\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "docs": "doxygen Doxyfile",
    "docs:clean": "rm -rf docs/doxygen",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print -exec php -l {} \\;",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite Unit"
  },
  "config": {
    "sort-packages": true
  }
}
